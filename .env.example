# =============================================================================
# .env.example — copy to `.env` and fill in. `.env` is gitignored; NEVER commit it.
#
#   cp .env.example .env
#
# §0.4: secrets live here and nowhere else. No key, token or secret may appear
# in any YAML, Python file, log line, or Telegram message.
# =============================================================================

# -----------------------------------------------------------------------------
# Zerodha Kite Connect  (https://developers.kite.trade/apps)
#
# OPTIONAL. Leave blank to run on free data: set `datafeed.source: free` in
# config/settings.yaml. Free data gives complete DAILY history and delayed
# quotes, but no 5-minute history beyond 60 days, no circuit bands, no option
# chain and no order routing. See core/sources.py for what that costs you.
# -----------------------------------------------------------------------------
KITE_API_KEY=your_kite_api_key
KITE_API_SECRET=your_kite_api_secret

# Written by `python scripts/morning_auth.py`. §8.1: this token EXPIRES DAILY
# around 07:30 IST. The 08:30 scheduler job verifies it and alerts on Telegram
# if the system is unauthenticated. Do not try to automate the login.
KITE_ACCESS_TOKEN=

# Your Zerodha client id, used only to label journal rows and the digest.
KITE_USER_ID=

# -----------------------------------------------------------------------------
# Anthropic  (core/llm.py — filings/sympathy/PEAD classification)
#
# OPTIONAL. Only needed when `llm.provider: anthropic` in settings.yaml.
# The default is `llm.provider: ollama`, which runs locally, needs no key, and
# sends nothing off the machine. Install Ollama from https://ollama.com/download
# then: ollama pull granite4.1:3b
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=

# -----------------------------------------------------------------------------
# Telegram  (live/alerts.py — real-time alerts, nightly digest, /kill)
#
# 1. Message @BotFather -> /newbot -> copy the token below.
# 2. Message your new bot once, then open
#    https://api.telegram.org/bot<TOKEN>/getUpdates and copy `chat.id`.
#
# TELEGRAM_CHAT_ID is an allowlist: ONLY this chat may issue /kill.
# -----------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# -----------------------------------------------------------------------------
# Overrides (optional). Leave unset to use config/settings.yaml.
#
# EXECUTION_MODE=live still requires an interactive y/N confirmation at
# startup (§0.1). Setting it here is not sufficient and is not a shortcut.
# -----------------------------------------------------------------------------
# EXECUTION_MODE=paper
# LOG_LEVEL=INFO
