{
  "type": "object",
  "required": ["tone", "confidence", "reason"],
  "properties": {
    "tone": {"type": "integer", "minimum": 0, "maximum": 10},
    "confidence": {"type": "number", "minimum": 0.0, "maximum": 1.0},
    "reason": {"type": "string"},
    "guidance": {
      "type": "string",
      "enum": ["RAISED", "MAINTAINED", "LOWERED", "WITHDRAWN", "NONE"]
    },
    "key_positives": {"type": "array", "maxItems": 3, "items": {"type": "string"}},
    "key_negatives": {"type": "array", "maxItems": 3, "items": {"type": "string"}}
  }
}
